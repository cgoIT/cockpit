{
  "sitewatch": "https://sitewatch.example",
  "interval": "5m",
  "spool": "/var/lib/sitewatch-agent",
  "composer": "/usr/share/sitewatch-agent/docker/composer-in-docker",
  "php": "/usr/share/sitewatch-agent/docker/php-in-docker",
  "nginx": "/usr/share/sitewatch-agent/docker/nginx-in-docker",
  "mariadb": "/usr/share/sitewatch-agent/docker/mariadb-in-docker",
  "sites": [
    {"id": "host-server1", "name": "Host Server1", "kind": "host", "token": "TOKEN-1", "path": "/appl"},
    {"id": "beispiel-php", "name": "beispiel-php", "kind": "php", "url": "https://php.example",
     "path": "/srv/websites/sites/beispiel-php/webroot",
     "env": {"SITE_DIR": "/srv/websites/sites/beispiel-php"}, "token": "TOKEN-2"},
    {"id": "beispiel-contao", "name": "Beispiel Contao", "kind": "contao", "url": "https://example.org",
     "path": "/srv/websites/sites/beispiel-contao/webroot",
     "backup_dir": "/srv/websites/sites/beispiel-contao/backups",
     "env": {"SITE_DIR": "/srv/websites/sites/beispiel-contao"}, "host": true,
     "ignore_updates": ["contao/*:6.*"],
     "token_file": "/etc/sitewatch-agent/beispiel-contao.token"}
  ]
}
