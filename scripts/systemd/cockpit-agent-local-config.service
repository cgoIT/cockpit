# Ein Agent für alle Sites des Servers. Konfiguration: /etc/cockpit-agent/config.json (nur root lesbar, chmod 600),
# siehe cockpit-agent.config.example.json. Variante mit Konfiguration aus dem Cockpit: cockpit-agent.service.
[Unit]
Description=Cockpit-Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cockpit-agent -config /etc/cockpit-agent/config.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
