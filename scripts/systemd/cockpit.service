# Das Cockpit selbst (Dashboard und Annahme der Reports). Lauscht nur lokal; davor gehört ein Reverse-Proxy mit TLS.
# Einrichtung (einmalig):
#   useradd --system --home /var/lib/cockpit --shell /usr/sbin/nologin cockpit
#   install -m 0755 cockpit /usr/local/bin/cockpit
#   install -d -m 0750 -o root -g cockpit /etc/cockpit
#   install -m 0640 -o root -g cockpit cockpit.env.example /etc/cockpit/cockpit.env   # dann ausfüllen
# Token anlegen (als derselbe Benutzer, sonst gehört die Datei root):
#   sudo -u cockpit /usr/local/bin/cockpit token -tokens /var/lib/cockpit/tokens.json <site-id>
# Anpassen: -allow-group (oder -allow-sub/-allow-email), -trusted-proxy, -public-url, ggf. -alert-*.
[Unit]
Description=Cockpit (Überwachung der Websites)
After=network-online.target
Wants=network-online.target

[Service]
User=cockpit
Group=cockpit
EnvironmentFile=/etc/cockpit/cockpit.env
ExecStart=/usr/local/bin/cockpit serve \
  -addr 127.0.0.1:8080 \
  -data /var/lib/cockpit \
  -tokens /var/lib/cockpit/tokens.json \
  -public-url https://cockpit.example \
  -allow-group cockpit \
  -trusted-proxy 127.0.0.1
# cockpit.db, Signaturschlüssel (signing.key), agents.json und tokens.json: /var/lib/cockpit (sichern!)
StateDirectory=cockpit
StateDirectoryMode=0750
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
