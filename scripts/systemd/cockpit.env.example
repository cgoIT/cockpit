# Beispiel (Vorlage, keine echten Werte) für /etc/cockpit/cockpit.env; Rechte 0640, Eigentümer root:cockpit.
COCKPIT_OIDC_ISSUER=https://auth.example/application/o/cockpit/
COCKPIT_OIDC_CLIENT_ID=
COCKPIT_OIDC_CLIENT_SECRET=
COCKPIT_OIDC_REDIRECT_URL=https://cockpit.example/callback
# fest halten, sonst verfallen alle Sitzungen:  openssl rand -hex 32
COCKPIT_SESSION_KEY=
# nur mit -alert-to:
#COCKPIT_SMTP_USER=
#COCKPIT_SMTP_PASSWORD=
