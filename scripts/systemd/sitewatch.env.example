# Beispiel (Vorlage, keine echten Werte) für /etc/sitewatch/sitewatch.env; Rechte 0640, Eigentümer root:sitewatch.
# Weitere Optionen: sitewatch serve -h (z. B. -alert-to/-alert-from/-alert-smtp, -thresholds)
SITEWATCH_ARGS=-public-url https://sitewatch.example -allow-group sitewatch -trusted-proxy 127.0.0.1
SITEWATCH_OIDC_ISSUER=https://auth.example/application/o/sitewatch/
SITEWATCH_OIDC_CLIENT_ID=
SITEWATCH_OIDC_CLIENT_SECRET=
SITEWATCH_OIDC_REDIRECT_URL=https://sitewatch.example/callback
# fest halten, sonst verfallen alle Sitzungen:  openssl rand -hex 32
SITEWATCH_SESSION_KEY=
# nur mit -alert-to:
#SITEWATCH_SMTP_USER=
#SITEWATCH_SMTP_PASSWORD=
