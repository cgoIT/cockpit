# Ein Agent für alle Sites des Servers, Sites und Intervall kommen signiert aus dem Cockpit (Dashboard „Agenten").
# Lokale Datei: /etc/cockpit-agent/bootstrap.json (nur root lesbar, chmod 600), siehe cockpit-agent.bootstrap.example.json.
# Ohne Fernkonfiguration (alles lokal): cockpit-agent-local-config.service.
[Unit]
Description=Cockpit-Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cockpit-agent -bootstrap /etc/cockpit-agent/bootstrap.json
# Nur nötig mit "actions" in der bootstrap.json und dem site-Werkzeug des Website-Stacks: Das Skript bin/site findet sein Root-Skript über
# diese Variable, die sonst nur "app shell init" in einer interaktiven Shell setzt. Pfad des bin-Verzeichnisses des Stacks anpassen.
#Environment=WEBSITES_APP_BIN_DIR=/srv/websites/bin
# Zwischenspeicher, Spool und Rollback-Schutz: /var/lib/cockpit-agent (= "state" in der bootstrap.json)
StateDirectory=cockpit-agent
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
